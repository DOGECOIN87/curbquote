# Copy to an uncommitted .env.local and configure from the provider's documentation/agreement.
# Start locally with: node --env-file=.env.local scripts/dev-server.mjs
# These placeholders do not authorize or enable a real provider.
DATA_USE_APPROVED=false
PROPERTY_PROVIDER_NAME=Your configured provider
PROPERTY_ALLOWED_HOSTS=api.provider.example
PROPERTY_LOOKUP_URL=https://api.provider.example/v1/property?address={address}
PROPERTY_API_KEY=
PROPERTY_RESPONSE_PATH=
PROPERTY_SOURCE_UPDATED_PATH=
# Omit PROPERTY_FIELD_MAP to use canonical names, or supply a complete explicit map.
PROPERTY_FIELD_MAP={"address":"address","region":"region","stories":"stories","year_built":"year_built","living_area_sqft":"living_area_sqft"}
# Change flags only to reflect an actual approved agreement. No default permission is granted.
PROPERTY_GRANT_JSON={"status":"pending","agreement_reference":"REPLACE_WITH_YOUR_AGREEMENT_REFERENCE","allowed_purposes":["estimate"],"allowed_fields":["address","region","stories","year_built","living_area_sqft"],"coverage_regions":["TX"],"may_store":false,"may_display":false,"may_process_with_ai":false,"may_export":false,"retention_days":null,"effective_at":null,"expires_at":null}
# Optional Google 3D view. Use a browser key restricted to your site's domains and the Map Tiles API only,
# with a daily root-tileset quota (for example 30) so usage stays inside Google's free monthly allowance.
GOOGLE_MAP_TILES_KEY=
# Testing alternative without Google billing: a Cesium ion token limited to assets:read and your site URLs.
# Cesium's free plan is for personal use and evaluation only; it is ignored when a Google key is set.
CESIUM_ION_TOKEN=
# Optional licensed building-footprint providers (require DATA_USE_APPROVED=true and homeowner consent).
# Open ODbL footprints (Microsoft / OpenStreetMap Overpass) remain available without commercial keys.
EARTHDEFINE_KEY=
EAGLEVIEW_KEY=
ATTOM_KEY=
MICROSOFT_FOOTPRINTS_URL=
# Optional "Send to Alco Products": an https URL that accepts a JSON POST (CRM form, Zapier/Make hook).
# Server-only; never shown to the browser. LEAD_EMAIL is the email fallback (and the only option on Pages).
LEAD_WEBHOOK_URL=
LEAD_EMAIL=
